<!doctype html>
<html lang="es">
<head>
<meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="theme-color" content="#f8eee8"><meta name="description" content="Bayoleth’s: chocotejas artesanales, sabores irresistibles, cajas especiales y envíos coordinados a todo el Perú.">
<title>Bayoleth’s | Chocotejas con un toque especial</title>
<link rel="preconnect" href="https://fonts.googleapis.com"><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Playfair+Display:wght@500;600;700&display=swap" rel="stylesheet">
<style>
:root{--cream:#fffaf5;--pink:#f2d9d7;--rose:#a85e64;--wine:#542f35;--gold:#c59a5b;--ink:#34272a;--muted:#78676a;--white:#fff}*{box-sizing:border-box}html{scroll-behavior:smooth}body{margin:0;background:var(--cream);color:var(--ink);font-family:'DM Sans',sans-serif}a{color:inherit;text-decoration:none}.announcement{background:var(--wine);color:#fff7f1;text-align:center;padding:10px 14px;font-size:12px;letter-spacing:.09em}.nav{max-width:1160px;margin:auto;padding:20px 24px;display:flex;align-items:center;justify-content:space-between;gap:20px}.brand{font-family:'Playfair Display',serif;font-size:27px;font-weight:700;color:var(--wine);letter-spacing:.02em}.brand span{color:var(--gold)}.navlinks{display:flex;gap:26px;font-size:13px;color:var(--muted)}.navlinks a:hover{color:var(--rose)}.nav-cta,.btn{display:inline-flex;align-items:center;justify-content:center;border-radius:999px;padding:13px 21px;font-weight:700;font-size:13px;transition:.2s}.nav-cta,.btn-primary{background:var(--wine);color:white}.nav-cta:hover,.btn-primary:hover{background:var(--rose);transform:translateY(-1px)}.hero{max-width:1160px;margin:0 auto;padding:42px 24px 76px;display:grid;grid-template-columns:1.02fr .98fr;align-items:center;gap:54px}.eyebrow{font-size:11px;letter-spacing:.19em;text-transform:uppercase;color:var(--rose);font-weight:700}.hero h1{font-family:'Playfair Display',serif;font-size:clamp(42px,5.3vw,70px);line-height:1.06;letter-spacing:-.035em;color:var(--wine);font-weight:600;margin:18px 0}.hero h1 em{font-weight:500;color:var(--rose)}.hero p{max-width:440px;color:var(--muted);font-size:15px;line-height:1.85}.hero-actions{display:flex;gap:12px;flex-wrap:wrap;margin-top:27px}.btn-outline{border:1px solid #d8c2bc;color:var(--wine);background:transparent}.btn-outline:hover{background:#f6e9e3}.hero-note{display:flex;align-items:center;gap:9px;margin-top:26px;font-size:12px;color:var(--muted)}.hero-note .dot{width:7px;height:7px;border-radius:50%;background:#82966a}.hero-panel{background:#f6e9e3;border:1px solid #ead8d0;border-radius:24px;padding:34px;min-height:330px;display:flex;flex-direction:column;justify-content:center}.hero-panel .ornament{font-size:40px;color:var(--gold);margin-bottom:18px}.hero-panel h2{font:600 30px/1.2 'Playfair Display',serif;color:var(--wine);margin:0 0 12px}.hero-panel p{font-size:13px;line-height:1.8;color:var(--muted)}.selection-wrap{max-width:800px;margin:28px auto 0;background:var(--cream);border:1px solid #ead8d0;border-radius:18px;padding:22px}.selection-title{font:600 22px 'Playfair Display',serif;color:var(--wine);margin:0 0 15px}.flavor-options{display:grid;grid-template-columns:repeat(3,1fr);gap:10px}.flavor-option{display:flex;align-items:center;gap:9px;border:1px solid #e4d1ca;border-radius:12px;padding:13px;font-size:13px;background:white;cursor:pointer}.flavor-option:has(input:checked){border-color:var(--rose);background:#f6e9e3}.flavor-option input{accent-color:var(--rose);width:16px;height:16px}.product-quantities{display:grid;gap:10px}.product-quantity{display:flex;align-items:center;justify-content:space-between;gap:14px;border:1px solid #e4d1ca;border-radius:12px;padding:14px;background:#fff}.product-quantity span{display:flex;flex-direction:column;gap:5px}.product-quantity strong{font-size:14px;color:var(--wine)}.product-quantity small{font-size:12px;color:var(--muted)}.product-quantity input{width:78px;padding:10px;border:1px solid #d8c2bc;border-radius:9px;font:inherit;color:var(--wine);background:#fffaf5}.selection-result{margin-top:17px;padding:14px;border-radius:10px;background:#f6e9e3;color:var(--wine);font-size:13px;line-height:1.7}.gift-panel{background:#f6e9e3;border:1px solid #ead8d0;border-radius:20px;padding:30px}.gift-panel .gift-symbol{font-size:36px;color:var(--gold)}.gift-panel h3{font:600 24px 'Playfair Display',serif;color:var(--wine)}.no-image-card{min-height:150px;display:flex;flex-direction:column;justify-content:center;align-items:flex-start;padding:20px;background:var(--cream);border-radius:18px;border:1px solid #ead8d0}.no-image-card .symbol{font-size:27px;color:var(--gold);margin-bottom:12px}.no-image-card h3{font:600 20px 'Playfair Display',serif;color:var(--wine);margin:0 0 8px}.no-image-card p{font-size:12px;color:var(--muted);line-height:1.7;margin:0}.section{padding:76px 24px}.section-inner{max-width:1100px;margin:auto}.section-heading{text-align:center;max-width:620px;margin:0 auto 38px}.section-heading h2{font:600 clamp(30px,4vw,44px)/1.15 'Playfair Display',serif;color:var(--wine);margin:12px 0}.section-heading p{font-size:14px;color:var(--muted);line-height:1.8}.flavors{background:#f6e9e3}.cards{display:grid;grid-template-columns:repeat(3,1fr);gap:20px}.flavor-card{background:var(--cream);border-radius:18px;overflow:hidden;border:1px solid #ead8d0}.flavor-copy{padding:20px}.flavor-copy h3{font:600 21px 'Playfair Display',serif;color:var(--wine);margin:0 0 8px}.flavor-copy p{font-size:12px;color:var(--muted);line-height:1.7;margin:0}.gift{display:grid;grid-template-columns:1fr 1fr;gap:54px;align-items:center}.gift-image{display:none}.gift h2{font:600 clamp(32px,4vw,47px)/1.12 'Playfair Display',serif;color:var(--wine);margin:14px 0}.gift p{font-size:14px;color:var(--muted);line-height:1.9}.price{font:700 28px 'Playfair Display',serif;color:var(--rose);margin:18px 0 5px}.price-note{font-size:12px;color:var(--muted);margin-bottom:23px}.features{background:var(--wine);color:white}.features .section-heading h2{color:#fff7f0}.features .section-heading p{color:#e5ceca}.feature-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:22px}.feature{text-align:center;padding:20px 15px}.feature-icon{font-size:27px;color:#e4c28a}.feature h3{font:600 20px 'Playfair Display',serif;margin:13px 0 8px}.feature p{font-size:12px;line-height:1.8;color:#e5ceca;max-width:260px;margin:auto}.order{padding:80px 24px;text-align:center;background:#f6e9e3}.order h2{font:600 clamp(34px,4vw,48px)/1.1 'Playfair Display',serif;color:var(--wine);margin:14px 0}.order p{font-size:14px;color:var(--muted);line-height:1.8;max-width:520px;margin:0 auto 25px}.locations{font-size:12px;color:var(--muted);margin-top:16px}.footer{background:#fffaf5;padding:27px 24px}.footer-inner{max-width:1100px;margin:auto;display:flex;justify-content:space-between;gap:15px;align-items:center;flex-wrap:wrap}.footer small{font-size:11px;color:var(--muted)}.social{font-size:12px;color:var(--rose);font-weight:700}.mobile-order{display:none}
.purchase-ticket{max-width:560px;margin:22px auto 0;background:#fff;border:1px solid #e4d1ca;border-radius:18px;overflow:hidden;box-shadow:0 12px 30px #542f3510;color:var(--ink)}.ticket-head{background:var(--wine);color:#fff7f0;text-align:center;padding:22px 18px}.ticket-head .ticket-star{color:#e4c28a;font-size:23px}.ticket-head h3{font:600 25px 'Playfair Display',serif;margin:7px 0 4px}.ticket-head p{margin:0;font-size:11px;letter-spacing:.14em;text-transform:uppercase;color:#e8d1ca}.ticket-body{padding:20px}.ticket-label{font-size:10px;letter-spacing:.14em;text-transform:uppercase;color:var(--rose);font-weight:700}.ticket-items{margin:13px 0;border-top:1px dashed #d9c1b4;border-bottom:1px dashed #d9c1b4;padding:12px 0;display:grid;gap:10px}.ticket-line{display:flex;justify-content:space-between;gap:12px;font-size:12px;line-height:1.5}.ticket-line span:last-child{text-align:right;white-space:nowrap}.ticket-total{display:flex;align-items:center;justify-content:space-between;gap:12px;margin-top:14px;color:var(--wine);font-weight:700}.ticket-total strong{font:600 27px 'Playfair Display',serif}.ticket-person{font-size:12px;line-height:1.8;color:var(--muted);margin-top:15px;overflow-wrap:anywhere}.ticket-foot{background:#fbf2ec;padding:13px 18px;text-align:center;font-size:10px;line-height:1.7;color:var(--muted)}.ticket-empty{color:var(--muted);font-size:12px;line-height:1.7}

@media(max-width:760px){.nav{padding:17px 18px}.navlinks{display:none}.nav-cta{padding:11px 15px;font-size:12px}.brand{font-size:24px}.hero{grid-template-columns:1fr;gap:30px;padding:28px 20px 55px}.hero h1{font-size:48px}.hero-panel{min-height:280px;padding:25px}.hero p{font-size:14px}.section{padding:58px 20px}.cards{grid-template-columns:1fr 1fr;gap:13px}.flavor-options{grid-template-columns:1fr 1fr}.flavor-option{font-size:12px;padding:11px}.product-quantity{padding:12px}.product-quantity strong{font-size:13px}.product-quantity input{width:68px}.flavor-copy{padding:15px}.flavor-copy h3{font-size:18px}.gift{grid-template-columns:1fr;gap:28px}.gift-panel{padding:22px}.feature-grid{grid-template-columns:1fr;gap:8px}.feature{padding:14px}.footer-inner{justify-content:center;text-align:center}.announcement{font-size:10px}.mobile-order{display:block;position:fixed;bottom:12px;left:12px;right:12px;z-index:9;text-align:center;background:#542f35;color:white;padding:14px;border-radius:999px;font-size:13px;font-weight:700;box-shadow:0 5px 25px #3c202744}.footer{padding-bottom:80px}}
</style></head>-wrap:wrap}.footer small{font-size:11px;color:var(--muted)}.social{font-size:12px;color:var(--rose);font-weight:700}.mobile-order{display:none}
.purchase-ticket{max-width:560px;margin:22px auto 0;background:#fff;border:1px solid #e4d1ca;border-radius:18px;overflow:hidden;box-shadow:0 12px 30px #542f3510;color:var(--ink)}.ticket-head{background:var(--wine);color:#fff7f0;text-align:center;padding:22px 18px}.ticket-head .ticket-star{color:#e4c28a;font-size:23px}.ticket-head h3{font:600 25px 'Playfair Display',serif;margin:7px 0 4px}.ticket-head p{margin:0;font-size:11px;letter-spacing:.14em;text-transform:uppercase;color:#e8d1ca}.ticket-body{padding:20px}.ticket-label{font-size:10px;letter-spacing:.14em;text-transform:uppercase;color:var(--rose);font-weight:700}.ticket-items{margin:13px 0;border-top:1px dashed #d9c1b4;border-bottom:1px dashed #d9c1b4;padding:12px 0;display:grid;gap:10px}.ticket-line{display:flex;justify-content:space-between;gap:12px;font-size:12px;line-height:1.5}.ticket-line span:last-child{text-align:right;white-space:nowrap}.ticket-total{display:flex;align-items:center;justify-content:space-between;gap:12px;margin-top:14px;color:var(--wine);font-weight:700}.ticket-total strong{font:600 27px 'Playfair Display',serif}.ticket-person{font-size:12px;line-height:1.8;color:var(--muted);margin-top:15px;overflow-wrap:anywhere}.ticket-foot{background:#fbf2ec;padding:13px 18px;text-align:center;font-size:10px;line-height:1.7;color:var(--muted)}.ticket-empty{color:var(--muted);font-size:12px;line-height:1.7}

@media(max-width:760px){.nav{padding:17px 18px}.navlinks{display:none}.nav-cta{padding:11px 15px;font-size:12px}.brand{font-size:24px}.hero{grid-template-columns:1fr;gap:30px;padding:28px 20px 55px}.hero h1{font-size:48px}.hero-panel{min-height:280px;padding:25px}.hero p{font-size:14px}.section{padding:58px 20px}.cards{grid-template-columns:1fr 1fr;gap:13px}.flavor-options{grid-template-columns:1fr 1fr}.flavor-option{font-size:12px;padding:11px}.product-quantity{padding:12px}.product-quantity strong{font-size:13px}.product-quantity input{width:68px}.flavor-copy{padding:15px}.flavor-copy h3{font-size:18px}.gift{grid-template-columns:1fr;gap:28px}.gift-panel{padding:22px}.feature-grid{grid-template-columns:1fr;gap:8px}.feature{padding:14px}.footer-inner{justify-content:center;text-align:center}.announcement{font-size:10px}.mobile-order{display:block;position:fixed;bottom:12px;left:12px;right:12px;z-index:9;text-align:center;background:#542f35;color:white;padding:14px;border-radius:999px;font-size:13px;font-weight:700;box-shadow:0 5px 25px #3c202744}.footer{padding-bottom:80px}}
</style></head>
<body>
<div class="announcement">UN DETALLE DULCE, HECHO PARA SORPRENDER ✦ ENVÍOS A TODO EL PERÚ</div>
<header class="nav"><a class="brand" href="#inicio">Bayoleth<span>’</span>s</a><nav class="navlinks"><a href="#sabores">Sabores</a><a href="#regalos">Packs y regalos</a><a href="#novedades">Novedades</a><a href="#reclamaciones">Libro de reclamaciones</a></nav><a class="nav-cta" href="https://wa.me/51906586064?text=Hola%20Bayoleth%E2%80%99s%2C%20quiero%20hacer%20un%20pedido" target="_blank" rel="noopener">Hacer un pedido ↗</a></header>
<main>
<section class="hero" id="inicio"><div><div class="eyebrow">Pequeños detalles · Grandes sonrisas</div><h1>Un antojito<br>con mucho <em>amor.</em></h1><p>Descubre nuestras chocotejas de chocolate, con rellenos irresistibles y presentaciones especiales para regalar o darte un gustito.</p><div class="hero-actions"><a class="btn btn-primary" href="#sabores">Descubrir sabores</a><a class="btn btn-outline" href="https://wa.me/51906586064?text=Hola%2C%20quisiera%20consultar%20por%20las%20chocotejas" target="_blank" rel="noopener">Consultar por WhatsApp</a></div><div class="hero-note"><span class="dot"></span> Envíos coordinados a todo el Perú</div></div><div class="hero-panel"><div class="ornament">✧ ♡ ✧</div><h2>Bayoleth’s</h2><p>Chocotejas que convierten cualquier momento en un detalle especial.</p><div style="border-top:1px solid #dfc7be;margin-top:10px;padding-top:16px;color:var(--rose);font-size:12px;letter-spacing:.12em">CALIDAD · SABOR · DETALLES</div></div></section>
<section class="section flavors" id="sabores"><div class="section-inner"><div class="section-heading"><div class="eyebrow">Encuentra tu favorito</div><h2>Sabores para enamorarte</h2><p>Un mundo de sabores para elegir. Escríbenos para consultar disponibilidad y armar tu combinación favorita.</p></div><div class="cards"><article class="no-image-card"><div class="symbol">✧</div><h3>Oreo</h3><p>Chocolate y galleta en una combinación deliciosa.</p></article><article class="no-image-card"><div class="symbol">✦</div><h3>Pecanas</h3><p>Un clásico con un toque crocante.</p></article><article class="no-image-card"><div class="symbol">♡</div><h3>Coco</h3><p>Una opción dulce para disfrutar.</p></article><article class="no-image-card"><div class="symbol">✧</div><h3>Casino de menta</h3><p>Un sabor refrescante y diferente.</p></article><article class="no-image-card"><div class="symbol">✦</div><h3>ChinChin</h3><p>Bolitas de colores para un toque divertido.</p></article><article class="no-image-card"><div class="symbol">♡</div><h3>Combinaciones</h3><p>Consulta por Oreo con Casino de menta y otras opciones.</p></article></div></div></div></section>
<section class="section" id="novedades" style="background:#fffaf5"><div class="section-inner"><div class="section-heading"><div class="eyebrow">Lo nuevo de Bayoleth’s</div><h2>Novedades y packs</h2><p>Descubre nuestras combinaciones y presentaciones especiales. Consulta la disponibilidad por WhatsApp.</p></div><div class="cards"><article class="no-image-card"><div class="symbol">✧</div><h3>Novedades</h3><p>Nuevos sabores y combinaciones por anunciar.</p></article><article class="no-image-card"><div class="symbol">♡</div><h3>Bayoleth’s Packs</h3><p>Presentaciones para regalar o compartir. Consulta las opciones disponibles.</p></article><article class="no-image-card"><div class="symbol">✦</div><h3>Atención por WhatsApp</h3><p>Escríbenos para consultar disponibilidad y coordinar tu pedido.</p></article></div></div></section>
<section class="section" id="regalos"><div class="section-inner"><div class="section-heading"><div class="eyebrow">Arma tu pedido</div><h2>Elige tus chocotejas</h2><p>Selecciona el tipo y la cantidad que deseas. Puedes combinar variedades y revisar el total antes de enviarnos tu pedido por WhatsApp.</p></div><div class="selection-wrap" style="margin-top:0"><h3 class="selection-title">1. Elige tus presentaciones</h3><div class="product-quantities"><label class="product-quantity"><span><strong>Chocoteja cuadrada</strong><small>S/ 2.00 cada una</small></span><input aria-label="Cantidad de chocotejas cuadradas" type="number" min="0" step="1" value="0" id="qtySquare"></label><label class="product-quantity"><span><strong>Chocoteja normal mediana</strong><small>S/ 2.00 cada una</small></span><input aria-label="Cantidad de chocotejas normales medianas" type="number" min="0" step="1" value="0" id="qtyMedium"></label><label class="product-quantity"><span><strong>Chocoteja normal grande</strong><small>S/ 4.00 cada una</small></span><input aria-label="Cantidad de chocotejas normales grandes" type="number" min="0" step="1" value="0" id="qtyLarge"></label></div><h3 class="selection-title" style="margin-top:24px">2. Marca los sabores</h3><div class="flavor-options"><label class="flavor-option"><input type="checkbox" name="sabor" value="Oreo"> Oreo</label><label class="flavor-option"><input type="checkbox" name="sabor" value="Pecanas"> Pecanas</label><label class="flavor-option"><input type="checkbox" name="sabor" value="Coco"> Coco</label><label class="flavor-option"><input type="checkbox" name="sabor" value="Casino de menta"> Casino de menta</label><label class="flavor-option"><input type="checkbox" name="sabor" value="ChinChin"> ChinChin</label><label class="flavor-option"><input type="checkbox" name="sabor" value="Oreo con Casino de menta"> Oreo con Casino de menta</label></div><div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(190px,1fr));gap:12px;margin-top:22px"><label style="font-size:13px;color:var(--wine)">Nombres y apellidos completos de quien pagará por Plin<input id="buyerName" type="text" autocomplete="name" placeholder="Escribe tus nombres y apellidos completos" required style="display:block;width:100%;margin-top:7px;padding:12px;border:1px solid #d8c2bc;border-radius:9px;background:white;font:inherit"></label><label style="font-size:13px;color:var(--wine)">Número de celular de contacto<input id="buyerPhone" type="tel" inputmode="tel" autocomplete="tel" placeholder="Ej. 987 654 321" required style="display:block;width:100%;margin-top:7px;padding:12px;border:1px solid #d8c2bc;border-radius:9px;background:white;font:inherit"></label><label style="font-size:13px;color:var(--wine)">Entrega (opcional)<input id="deliveryInfo" type="text" placeholder="Distrito o dirección a coordinar" style="display:block;width:100%;margin-top:7px;padding:12px;border:1px solid #d8c2bc;border-radius:9px;background:white;font:inherit"></label></div><div style="margin-top:18px;padding:18px;border:1px solid #d9c1b4;border-radius:14px;background:#fff"><h3 class="selection-title" style="margin-bottom:8px">3. Paga por Plin</h3><p style="margin:0;color:var(--muted);font-size:13px;line-height:1.8">Número de Plin: <strong style="font-size:19px;color:var(--wine);white-space:nowrap">960 299 889</strong></p><p style="margin:8px 0 0;color:var(--muted);font-size:12px;line-height:1.8">Al realizar el pago, escribe tus nombres y apellidos completos y asegúrate de que coincidan con el nombre registrado en el pedido. Envía la constancia de pago por WhatsApp para verificarlo. <strong>Los pedidos con anticipación deben pagarse completos por adelantado.</strong> Espera la confirmación de Bayoleth’s antes de dar el pedido por confirmado.</p></div><div style="margin-top:18px;text-align:left"><label for="paymentProof" style="display:block;font-size:13px;color:var(--wine);font-weight:700">Foto del comprobante de Plin</label><input id="paymentProof" type="file" accept="image/*" capture="environment" style="display:block;width:100%;margin-top:8px;padding:12px;border:1px dashed #d8c2bc;border-radius:10px;background:#fff"><p id="proofName" style="font-size:12px;color:var(--muted);margin:8px 0 0">Puedes tomar una foto o elegir una imagen. Luego adjúntala manualmente en WhatsApp.</p></div><div id="selectionResult" class="selection-result">Elige cantidades y sabores para preparar tu pedido.</div><div class="purchase-ticket" aria-live="polite"><div class="ticket-head"><div class="ticket-star">✦</div><h3>Bayoleth’s</h3><p>Resumen de tu pedido</p></div><div class="ticket-body"><div class="ticket-label">Detalle de compra</div><div id="ticketItems" class="ticket-items"><p class="ticket-empty">Aquí aparecerán las chocotejas y cantidades que elijas.</p></div><div class="ticket-line"><span>Sabores</span><span id="ticketFlavors">Por coordinar</span></div><div class="ticket-total"><span>Total estimado</span><strong id="ticketTotal">S/ 0.00</strong></div><div class="ticket-person"><div><strong>Cliente:</strong> <span id="ticketName">Falta indicar nombres y apellidos completos</span></div><div><strong>Celular:</strong> <span id="ticketPhone">Falta indicar celular</span></div><div><strong>Entrega:</strong> <span id="ticketDelivery">Por coordinar</span></div></div></div><div class="ticket-foot">Gracias por elegir Bayoleth’s. Este resumen no reemplaza la boleta de venta oficial.</div></div><div style="display:flex;justify-content:center;flex-wrap:wrap;margin-top:14px"><a class="btn btn-primary" id="sendSelection" href="https://wa.me/51906586064" target="_blank" rel="noopener">Enviar pedido por WhatsApp ↗</a></div><p style="font-size:12px;line-height:1.7;color:var(--muted);margin-top:12px">El pedido quedará pendiente hasta que Bayoleth’s confirme disponibilidad, entrega y pago. La boleta de venta oficial se enviará cuando sea emitida por el sistema de comprobantes correspondiente.</p></div></div></section><section class="section features" id="nosotros"><div class="section-inner"><div class="section-heading"><div class="eyebrow" style="color:#e4c28a">La esencia Bayoleth’s</div><h2>Detalles que se sienten</h2><p>Porque un regalo especial empieza con una buena elección.</p></div><div class="feature-grid"><div class="feature"><div class="feature-icon">✧</div><h3>Sabores variados</h3><p>Opciones para distintos gustos y antojos, con disponibilidad por confirmar.</p></div><div class="feature"><div class="feature-icon">♡</div><h3>Presentaciones especiales</h3><p>Cajas pensadas para convertir un detalle dulce en un recuerdo bonito.</p></div><div class="feature"><div class="feature-icon">✦</div><h3>Atención cercana</h3><p>Coordinamos contigo los sabores, la presentación y los detalles de tu pedido.</p></div></div></div></section>
<section class="order"><div class="eyebrow">Tu próximo antojito te espera</div><h2>¿Se te antojaron?</h2><p>Escríbenos y coordinamos tu pedido. Realizamos envíos a todo el Perú; consulta por WhatsApp la cobertura, el costo y el tiempo estimado para tu destino.</p><a class="btn btn-primary" href="https://wa.me/51906586064?text=Hola%20Bayoleth%E2%80%99s%2C%20quiero%20hacer%20un%20pedido" target="_blank" rel="noopener">Pedir por WhatsApp ↗</a><div class="locations">WhatsApp: 906 586 064 · Envíos a todo el Perú</div></section>

<section class="section" id="reclamaciones" style="background:#fffaf5"><div class="section-inner" style="max-width:760px"><div class="section-heading"><div class="eyebrow">Tu opinión importa</div><h2>Libro de Reclamaciones</h2><p>Queremos atenderte mejor. Completa los datos para dejar constancia de tu reclamo o queja sobre un producto o servicio.</p></div><form id="complaintForm" style="background:#fff;border:1px solid #ead8d0;border-radius:18px;padding:24px;display:grid;grid-template-columns:1fr 1fr;gap:15px"><label style="font-size:13px">Tipo de solicitud<select name="tipo" required style="display:block;width:100%;margin-top:7px;padding:12px;border:1px solid #d8c2bc;border-radius:9px;background:white"><option value="">Selecciona</option><option>Reclamo (disconformidad con el producto o servicio)</option><option>Queja (malestar con la atención)</option></select></label><label style="font-size:13px">Fecha<input name="fecha" type="date" required style="display:block;width:100%;margin-top:7px;padding:12px;border:1px solid #d8c2bc;border-radius:9px"></label><label style="font-size:13px">Nombres y apellidos<input name="nombre" required autocomplete="name" style="display:block;width:100%;margin-top:7px;padding:12px;border:1px solid #d8c2bc;border-radius:9px"></label><label style="font-size:13px">Documento de identidad (tipo y número)<input name="documento" required style="display:block;width:100%;margin-top:7px;padding:12px;border:1px solid #d8c2bc;border-radius:9px"></label><label style="font-size:13px">Correo electrónico<input name="correo" type="email" required autocomplete="email" style="display:block;width:100%;margin-top:7px;padding:12px;border:1px solid #d8c2bc;border-radius:9px"></label><label style="font-size:13px">Teléfono<input name="telefono" type="tel" required autocomplete="tel" style="display:block;width:100%;margin-top:7px;padding:12px;border:1px solid #d8c2bc;border-radius:9px"></label><label style="font-size:13px;grid-column:1/-1">Dirección<input name="direccion" required autocomplete="street-address" style="display:block;width:100%;margin-top:7px;padding:12px;border:1px solid #d8c2bc;border-radius:9px"></label><label style="font-size:13px;grid-column:1/-1">Detalle del producto o servicio y monto involucrado (si corresponde)<textarea name="detalle" rows="3" required style="display:block;width:100%;margin-top:7px;padding:12px;border:1px solid #d8c2bc;border-radius:9px;resize:vertical"></textarea></label><label style="font-size:13px;grid-column:1/-1">Detalle de la reclamación o queja y pedido del consumidor<textarea name="pedido" rows="4" required style="display:block;width:100%;margin-top:7px;padding:12px;border:1px solid #d8c2bc;border-radius:9px;resize:vertical"></textarea></label><div style="grid-column:1/-1;font-size:12px;line-height:1.7;color:#78676a">Importante: este formulario de demostración aún no envía ni registra oficialmente la reclamación. Para ponerlo en funcionamiento, Bayoleth’s debe completar sus datos legales y conectarlo a un sistema que permita recibir, registrar y responder las solicitudes.</div><button class="btn btn-primary" type="submit" style="grid-column:1/-1;border:0;cursor:pointer">Preparar reclamación</button><p id="complaintNotice" role="status" style="grid-column:1/-1;font-size:13px;color:#542f35;margin:0"></p></form></div></section>
</main><footer class="footer"><div class="footer-inner"><a class="brand" href="#inicio">Bayoleth<span>’</span>s</a><small>Un detalle dulce para cada ocasión. © Bayoleth’s · <a href="#reclamaciones" style="text-decoration:underline">Libro de Reclamaciones</a></small><a class="social" href="https://wa.me/51906586064" target="_blank" rel="noopener">Hablemos por WhatsApp ↗</a></div></footer><a class="mobile-order" href="https://wa.me/51906586064?text=Hola%20Bayoleth%E2%80%99s%2C%20quiero%20hacer%20un%20pedido" target="_blank" rel="noopener">♡ Hacer un pedido por WhatsApp</a><script>
document.getElementById('complaintForm').addEventListener('submit',function(e){e.preventDefault();document.getElementById('complaintNotice').textContent='Este formulario es una vista previa y todavía no envía tu reclamación. No se ha registrado oficialmente. Contacta a Bayoleth’s por WhatsApp para recibir orientación mientras se habilita el sistema oficial.';});
const today=new Date();document.querySelector('[name="fecha"]').value=today.getFullYear()+'-'+String(today.getMonth()+1).padStart(2,'0')+'-'+String(today.getDate()).padStart(2,'0');
const flavorChecks=[...document.querySelectorAll('input[name="sabor"]')];const selectionResult=document.getElementById('selectionResult');const sendSelection=document.getElementById('sendSelection');const products=[{id:'qtySquare',name:'Chocoteja cuadrada',price:2},{id:'qtyMedium',name:'Chocoteja normal mediana',price:2},{id:'qtyLarge',name:'Chocoteja normal grande',price:4}];function getOrder(){let lines=[];let total=0;let count=0;products.forEach(p=>{const el=document.getElementById(p.id);const qty=Math.max(0,parseInt(el.value,10)||0);el.value=qty;if(qty){lines.push({qty,name:p.name,price:p.price,subtotal:qty*p.price});total+=qty*p.price;count+=qty;}});const chosen=flavorChecks.filter(x=>x.checked).map(x=>x.value);return {lines,total,count,flavors:chosen.length?chosen.join(', '):'Por coordinar',name:document.getElementById('buyerName').value.trim()||'Falta indicar nombres y apellidos completos',phone:document.getElementById('buyerPhone').value.trim()||'Falta indicar celular',delivery:document.getElementById('deliveryInfo').value.trim()||'Por coordinar'};}function updateFlavorSelection(){const o=getOrder();const lines=o.lines.map(x=>x.qty+' x '+x.name+' (S/ '+x.price.toFixed(2)+' c/u)');const summary=o.count?lines.join('\n')+'\nCantidad total: '+o.count+' chocoteja(s)\nTotal estimado: S/ '+o.total.toFixed(2)+'\nSabores: '+o.flavors:'Elige cantidades y sabores para preparar tu pedido.';selectionResult.textContent=summary;const ticketItems=document.getElementById('ticketItems');ticketItems.innerHTML=o.lines.length?o.lines.map(x=>'<div class="ticket-line"><span>'+x.qty+' × '+esc(x.name)+'</span><span>S/ '+x.subtotal.toFixed(2)+'</span></div>').join(''):'<p class="ticket-empty">Aquí aparecerán las chocotejas y cantidades que elijas.</p>';document.getElementById('ticketFlavors').textContent=o.flavors;document.getElementById('ticketTotal').textContent='S/ '+o.total.toFixed(2);document.getElementById('ticketName').textContent=o.name;document.getElementById('ticketPhone').textContent=o.phone;document.getElementById('ticketDelivery').textContent=o.delivery;sendSelection.href='https://wa.me/51906586064?text='+encodeURIComponent('Hola Bayoleth’s, quiero hacer este pedido:\n'+(o.count?lines.join('\n')+'\nCantidad total: '+o.count+' chocoteja(s)\nTotal estimado: S/ '+o.total.toFixed(2):'Quiero consultar las chocotejas disponibles.')+'\nSabores elegidos: '+o.flavors+'\nNombre completo del pagador: '+o.name+'\nCelular de contacto: '+o.phone+'\nEntrega: '+o.delivery+'\nComprobante de Plin: adjuntaré la foto manualmente en este chat.\nBoleta de venta: solicito que me envíen la boleta oficial por WhatsApp cuando sea emitida.\nSi es un pedido con anticipación, entiendo que debo pagar el total por adelantado. Por favor, confirmen el total, envío y pago recibido.');}function esc(v){return String(v).replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));}flavorChecks.forEach(x=>x.addEventListener('change',updateFlavorSelection));products.forEach(p=>document.getElementById(p.id).addEventListener('input',updateFlavorSelection));document.getElementById('buyerName').addEventListener('input',updateFlavorSelection);document.getElementById('buyerPhone').addEventListener('input',updateFlavorSelection);document.getElementById('deliveryInfo').addEventListener('input',updateFlavorSelection);document.getElementById('paymentProof').addEventListener('change',function(){const f=this.files&&this.files[0];document.getElementById('proofName').textContent=f?'Foto elegida: '+f.name+'. Recuerda adjuntarla manualmente en el chat de WhatsApp.':'Todavía no has elegido una foto.';});updateFlavorSelection();
</script></body></html>
